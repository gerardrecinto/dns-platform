// Managed by Ansible.
options {
    directory "/var/cache/bind";
    listen-on { any; };
    listen-on-v6 { none; };
    recursion no;
    allow-query { any; };
    allow-transfer { none; };
    dnssec-validation no;
};

statistics-channels {
    inet 0.0.0.0 port 8053 allow { any; };
};

logging {
    channel file_log {
        file "/var/log/named/named.log" versions 3 size 5m;
        severity info;
        print-time yes;
        print-severity yes;
        print-category yes;
    };
    category default { file_log; };
    category queries { null; };
};
